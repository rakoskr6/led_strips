# Python packages used by led_interface.py and set_config.py.
# On the Pi these all come from apt (python3-numpy, python3-scipy, python3-pil,
# python3-serial, python3-websocket, python3-pyaudio) and the venv is created
# with --system-site-packages, so nothing needs to be pip-installed.
numpy
scipy
pillow
pyserial
websocket-client
pyaudio
